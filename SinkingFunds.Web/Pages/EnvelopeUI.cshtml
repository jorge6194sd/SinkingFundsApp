@page
@using SinkingFunds.Web.Pages
@model EnvelopeUIModel

<link rel="stylesheet" href="~/css/envelope-ui.css" />


<main class="sinking-funds-page">

    <!-- PAGE HEADER -->
    <header class="page-header">
        <h1>Sinking Funds</h1>
        <p>Plan upcoming expenses with envelopes.</p>
    </header>


    <!-- TEMPORARY STATUS / FEEDBACK -->
    <section class="page-status">

        @if (Model.CreatedEnvelopeId.HasValue)
        {
            <p>Created Envelope ID: @Model.CreatedEnvelopeId</p>
        }

        @if (Model.CurrentBalance.HasValue)
        {
            <p>Current Balance: @Model.CurrentBalance</p>
        }

    </section>


    <!-- SUMMARY AREA -->
    <section class="summary-section">

        <div class="summary-item">
            <span>Total Saved</span>
        </div>

        <div class="summary-item">
            <span>Total Targets</span>
        </div>

        <div class="summary-item">
            <span>Active Envelopes</span>
        </div>

    </section>


    <!-- ENVELOPE MANAGEMENT -->
    <section class="envelope-management">

        <!-- CREATE ENVELOPE -->
        <article class="management-card">

            <h2>Create Envelope</h2>

            <form method="post" asp-page-handler="Create">

                <input name="Name"
                       placeholder="Envelope name" />

                <button type="submit">
                    Create
                </button>

            </form>

        </article>


        <!-- UPDATE TARGET -->
        <article class="management-card">

            <h2>Update Target Amount</h2>

            <form method="post"
                  asp-page-handler="UpdateTargetAmount">

                <select name="EnvelopeId" required>

                    <option value=""
                            disabled
                            selected>
                        Select Envelope
                    </option>

                    @foreach (var envelope in Model.Envelopes)
                    {
                        <option value="@envelope.Id">
                            @envelope.Name
                        </option>
                    }

                </select>

                <input name="Amount"
                       placeholder="Amount" />

                <button type="submit">
                    Update
                </button>

            </form>

        </article>


        <!-- UPDATE MONTHLY CONTRIBUTION -->
        <article class="management-card">

            <h2>Update Monthly Contribution</h2>

            <form method="post"
                  asp-page-handler="UpdateMonthlyAmount">

                <select name="EnvelopeId" required>

                    <option value=""
                            disabled
                            selected>
                        Select Envelope
                    </option>

                    @foreach (var envelope in Model.Envelopes)
                    {
                        <option value="@envelope.Id">
                            @envelope.Name
                        </option>
                    }

                </select>

                <input name="Amount"
                       placeholder="Amount" />

                <button type="submit">
                    Update
                </button>

            </form>

        </article>


        <!-- DELETE ENVELOPE -->
        <article class="management-card">

            <h2>Delete Envelope</h2>

            <form method="post"
                  asp-page-handler="Delete">

                <select name="EnvelopeId" required>

                    <option value=""
                            disabled
                            selected>
                        Select Envelope
                    </option>

                    @foreach (var envelope in Model.Envelopes)
                    {
                        <option value="@envelope.Id">
                            @envelope.Name
                        </option>
                    }

                </select>

                <button type="submit">
                    Delete
                </button>

            </form>

        </article>

    </section>


    <!-- ENVELOPE DISPLAY -->
    <section class="envelopes-section">

        <header class="envelopes-header">

            <h2>Envelopes</h2>

            <span>
                @Model.Envelopes.Count envelopes
            </span>

        </header>


        <ul class="envelope-list">

            @foreach (var envelope in Model.Envelopes)
            {
                <li class="envelope-item">

                    <article class="envelope-card">


                        <!-- ENVELOPE IDENTITY -->
                        <div class="envelope-identity">

                            <h3>@envelope.Name</h3>

                        </div>


                        <!-- ENVELOPE METRICS -->
                        <div class="envelope-metrics">

                            <div class="envelope-metric">

                                <span>Balance</span>

                                <span>
                                    @envelope.Balance.ToString("C")
                                </span>

                            </div>


                            <div class="envelope-metric">

                                <span>Target</span>

                                <span>
                                    @(envelope.TargetAmount.HasValue
                                        ? envelope.TargetAmount.Value.ToString("C")
                                        : "Not set")
                                </span>

                            </div>


                            <div class="envelope-metric">

                                <span>Monthly Contribution</span>

                                <span>
                                    @(envelope.RuleAmount.HasValue
                                        ? envelope.RuleAmount.Value.ToString("C")
                                        : "Not set")
                                </span>

                            </div>


                            <div class="envelope-metric">

                                <span>Months Remaining</span>

                                <span>
                                    @envelope.MonthsRemaining
                                </span>

                            </div>

                        </div>


                        <!-- ENVELOPE ACTIONS -->
                        <div class="envelope-actions">


                            <!-- DEPOSIT -->
                            <div class="deposit-section">

                                <form method="post"
                                      asp-page-handler="Deposit"
                                      asp-route-envelopeId="@envelope.Id">

                                    <input name="Amount"
                                           placeholder="Amount" />

                                    <input name="Description"
                                           placeholder="Description" />

                                    <button type="submit">
                                        Deposit
                                    </button>

                                </form>

                            </div>


                            <!-- WITHDRAW -->
                            <div class="withdraw-section">

                                <form method="post"
                                      asp-page-handler="Withdraw"
                                      asp-route-envelopeId="@envelope.Id">

                                    <input name="Amount"
                                           placeholder="Amount" />

                                    <input name="Description"
                                           placeholder="Description" />

                                    <button type="submit">
                                        Withdraw
                                    </button>

                                </form>

                            </div>

                        </div>

                    </article>

                </li>
            }

        </ul>

    </section>

</main>