@page
@using SinkingFunds.Web.Pages
@model EnvelopeUIModel



    <h1> Envelope Demo UI</h1>

@if(Model.CreatedEnvelopeId.HasValue)
{
    <p>Created Envelope ID: @Model.CreatedEnvelopeId</p>
}

@if(Model.CurrentBalance.HasValue)
{
    <p>Current Balance: @Model.CurrentBalance</p>
}

    <h2>Create Envelope</h2>
    <form method="post" asp-page-handler="Create">
        <input name="Name" placeholder="Envelope name" />
        <button type="submit">Create</button>
    </form>

<h2>Deposit</h2>
<form method="post" asp-page-handler="Deposit">
    <select name="EnvelopeId">
        <option value="" disabled selected>Select Envelope</option>
        @foreach(var envelope in Model.Envelopes)
            {
                <option value="@envelope.Id">@envelope.Name</option>
            }

    </select>
    <input name="Amount" placeholder="Amount" />
    <input name="Description" placeholder="Description" />
    <button type="submit">Deposit</button>
</form>

<h2>Withdraw</h2>
<form method="post" asp-page-handler="Withdraw">
    <select id="WithdrawEnvelopeId" name="EnvelopeId" required>
        <option value="" disabled selected>Select Envelope</option>
        @foreach (var envelope in Model.Envelopes)
        {
            <option value="@envelope.Id">@envelope.Name</option>
        }
     </select>
    <input name="Amount" placeholder="Amount" />
    <input name="Description" placeholder="Description" />
    <button type="submit">Withdraw</button>
</form>


<h2>Delete Envelope</h2>
<form method="post" asp-page-handler="Delete">
    <select name="EnvelopeId" required>
        <option value="" disabled selected>Select Envelope</option>
        @foreach (var envelope in Model.Envelopes)
        {
            <option value="@envelope.Id">@envelope.Name</option>
        }
    </select>
    <button type="submit">Delete</button>
</form>

<h2>Update Target Amount</h2>
<form method="post" asp-page-handler="UpdateTargetAmount">
    <select name="EnvelopeId" required>
        <option value="" disabled selected>Select Envelope</option>
        @foreach (var envelope in Model.Envelopes)
        {
            <option value="@envelope.Id">@envelope.Name</option>
        }
    </select>
    <input name="Amount" placeholder="Amount" />
    <button type="submit">Update</button>
</form>

<h2>Update Monthly Contribution</h2>
<form method="post" asp-page-handler="UpdateMonthlyAmount">
    <select name="EnvelopeId" required>
        <option value="" disabled selected>Select Envelope</option>
        @foreach (var envelope in Model.Envelopes)
        {
            <option value="@envelope.Id">@envelope.Name</option>
        }
    </select>

    <input name="Amount" placeholder="Amount" />

    <button type="submit">Update</button>
</form>


<h2>Envelope Grid</h2>

<table border="1">
    <thead>
        <tr>
            <th>Name</th>
            <th>Id</th>
            <th>Balance</th>
            <th>TargetAmount</th>
            <th>RuleAmount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var envelope in Model.Envelopes)
        {
            <tr>
                <td>@envelope.Name</td>
                <td>@envelope.Id</td>
                <td>@envelope.Balance</td>
                <td>
                    @(envelope.TargetAmount.HasValue
                        ? envelope.TargetAmount.Value.ToString("C")
                        : "Not set")
                </td>
                <td>
                    @(envelope.RuleAmount.HasValue
                        ? envelope.RuleAmount.Value.ToString("C")
                        : "Not set")
                </td>
            </tr>
        }
    </tbody>
</table>


